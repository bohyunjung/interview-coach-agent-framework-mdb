{
  "name": "Interview Coach with MongoDB Memory",

  "image": "mcr.microsoft.com/devcontainers/dotnet:10.0-noble",

  "features": {
    "ghcr.io/devcontainers/features/common-utils:latest": {},
    "ghcr.io/devcontainers/features/docker-in-docker:latest": {},
    "ghcr.io/devcontainers/features/github-cli:latest": {},
    "ghcr.io/devcontainers/features/python:latest": {
      "version": "3.12"
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    }
  },

  "overrideFeatureInstallOrder": [
    "ghcr.io/devcontainers/features/common-utils"
  ],

  "customizations": {
    "vscode": {
      "extensions": [
        "EditorConfig.EditorConfig",
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "ms-azuretools.vscode-docker",
        "ms-dotnettools.csharp",
        "ms-dotnettools.csdevkit",
        "ms-python.python",
        "mongodb.mongodb-vscode"
      ],

      "settings": {
        "editor.minimap.enabled": false,
        "explorer.sortOrder": "type",
        "explorer.fileNesting.enabled": true,
        "explorer.fileNesting.patterns": {
          "appsettings.json": "appsettings.Development.json, appsettings.Development.sample.json",
          "*.razor": "${capture}.razor.js, ${capture}.razor.css, ${capture}.razor.cs",
          "*.js": "${capture}.js.map"
        }
      }
    }
  },

  "forwardPorts": [5087, 5152, 5141],

  "portsAttributes": {
    "5087": { "label": "Web UI", "onAutoForward": "notify" },
    "5152": { "label": "Agent (DevUI)", "onAutoForward": "notify" },
    "5141": { "label": "Memory MCP", "onAutoForward": "silent" }
  },

  "remoteEnv": {
    "PATH": "${containerEnv:PATH}:/home/vscode/.aspire/bin"
  },

  "remoteUser": "vscode",

  "onCreateCommand": "/bin/bash ./.devcontainer/on-create.sh > ~/on-create.log",

  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "16gb"
  }
}
