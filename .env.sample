# Copy to .env (git-ignored) and fill in. See docs/PREREQUISITES.md.
MONGODB_URI=mongodb+srv://<db-user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
VOYAGE_API_KEY=<atlas-model-api-key>

# Optional overrides
# MONGODB_DATABASE=interview_coach
# VOYAGE_MODEL=voyage-4-lite
# VOYAGE_DIMENSIONS=1024
# CHAT_MESSAGES_TTL_DAYS=30
