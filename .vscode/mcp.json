{
  "inputs": [
    {
      "id": "mongodb-readonly-uri",
      "type": "promptString",
      "description": "MongoDB connection string. Paste MONGODB_URI from .env, or a read-only Atlas user (the server also runs with --readOnly)",
      "password": true
    }
  ],
  "servers": {
    "mongodb": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "mongodb-mcp-server@latest", "--readOnly"],
      "env": {
        "MDB_MCP_CONNECTION_STRING": "${input:mongodb-readonly-uri}"
      }
    }
  }
}
